{
  "name": "patchport",
  "displayName": "PatchPort - AI Terminal Bridge",
  "description": "Connect Codex, Claude Code and local Ollama or LM Studio conversations inside your VS Code workspace.",
  "version": "0.6.0",
  "publisher": "utialy",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "AI",
    "terminal",
    "claude",
    "codex",
    "agents"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/utialy/PatchPort"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:patchport.openBoard",
    "onView:patchport.sessions"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "The board can be viewed, but terminals and profiles require a trusted workspace."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "patchport.openBoard",
        "title": "PatchPort: Open AI Terminal Board",
        "icon": "$(layout)"
      },
      {
        "command": "patchport.addTerminal",
        "title": "PatchPort: Add AI Terminal",
        "icon": "$(add)"
      },
      {
        "command": "patchport.manageProfiles",
        "title": "PatchPort: Configure Launch Profiles"
      },
      {
        "command": "patchport.connectExisting",
        "title": "PatchPort: Show Existing VS Code Terminals"
      },
      {
        "command": "patchport.stopAll",
        "title": "PatchPort: Stop All Managed Terminals"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "patchport",
          "title": "PatchPort",
          "icon": "media/bridge.svg"
        }
      ]
    },
    "views": {
      "patchport": [
        {
          "id": "patchport.sessions",
          "name": "AI Terminals"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "patchport.openBoard",
          "when": "view == patchport.sessions",
          "group": "navigation"
        },
        {
          "command": "patchport.addTerminal",
          "when": "view == patchport.sessions",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "PatchPort",
      "properties": {
        "patchport.corePython": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Python 3.11+ for the bundled core. Leave empty for python on Windows or python3 on Linux/macOS. Use an absolute path to select a runtime; reload after changing it."
        },
        "patchport.profiles": {
          "type": "array",
          "default": [],
          "scope": "machine-overridable",
          "description": "Named CLI launch profiles. Command and arguments are separate; choose a shell to use profile functions and aliases.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "provider",
              "command"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "provider": {
                "enum": [
                  "claude",
                  "codex",
                  "terminal"
                ]
              },
              "command": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "shell": {
                "enum": [
                  "powershell",
                  "pwsh",
                  "bash",
                  "zsh",
                  "direct"
                ],
                "default": "direct"
              },
              "shellPath": {
                "type": "string"
              },
              "profilePath": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "patchport.localProfiles": {
          "type": "array",
          "default": [],
          "scope": "machine-overridable",
          "description": "Local conversation profiles for Ollama and LM Studio. Use Launch profiles to discover models and store an optional LM Studio API token in SecretStorage. Filesystem tools and batch roles are not supported.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "backend",
              "endpointOrigin",
              "modelId",
              "contextWindow",
              "maxOutputTokens",
              "requestTimeoutSec",
              "revision",
              "executionLocationConfirmed"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "backend": {
                "type": "string",
                "enum": [
                  "ollama",
                  "lmstudio"
                ]
              },
              "endpointOrigin": {
                "type": "string",
                "description": "HTTP loopback origin only, such as http://127.0.0.1:11434 or http://127.0.0.1:1234. API paths, credentials and remote hosts are not accepted."
              },
              "modelId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "description": "Exact text generation model ID reported by the local server."
              },
              "contextWindow": {
                "type": "integer",
                "minimum": 2,
                "maximum": 2097152,
                "description": "Context requested from Ollama, or the actual loaded context configured in LM Studio. This is distinct from the model's advertised maximum."
              },
              "maxOutputTokens": {
                "type": "integer",
                "minimum": 1,
                "maximum": 32768,
                "default": 1024,
                "description": "Maximum output tokens; must be less than contextWindow."
              },
              "requestTimeoutSec": {
                "type": "integer",
                "minimum": 1,
                "maximum": 300,
                "default": 300,
                "description": "Total generation request deadline in seconds."
              },
              "revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "description": "Profile revision frozen for each session. Saving in Launch profiles generates a new revision."
              },
              "executionLocationConfirmed": {
                "type": "boolean",
                "default": false,
                "description": "Confirm that the server is configured to run this model locally. A loopback address alone does not prove offline execution."
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.cjs",
    "package": "npm run check && npm run build && node scripts/package.cjs",
    "test:host": "node scripts/test-host.cjs"
  },
  "dependencies": {
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.100.0",
    "@vscode/test-electron": "^2.5.0",
    "@vscode/vsce": "^4.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "^6.0.0",
    "esbuild": "^0.25.0",
    "playwright-core": "^1.55.0",
    "typescript": "^5.9.0"
  },
  "icon": "media/symbol.png"
}
